# Copiar a .env SOLO en servidor. No subir a Git.
# Contrato auditable de variables: ninguna tiene valor real.
COMPOSE_PROJECT_NAME=hefesto-atencion
STORAGE_VOLUME=hefesto_atencion_storage
REDIS_VOLUME=hefesto_atencion_redis
CHAT_HOST=atencion.tu-dominio.cl
SECRET_KEY_BASE=GENERAR
REDIS_PASSWORD=GENERAR
POSTGRES_HOST=db.REEMPLAZAR.supabase.co
POSTGRES_USERNAME=chatwoot_app
POSTGRES_PASSWORD=GENERAR
SUPABASE_DEDICATED_CONFIRMED=true
SUPABASE_DATA_API_DISABLED=true
DB_HOST=db.REEMPLAZAR.supabase.co
DB_NAME=postgres
DB_PASSWORD=GENERAR
DB_SSLMODE=require
# SMTP desactivado hasta que el cliente defina proveedor y remitente.
SMTP_READY=false
SMTP_ADDRESS=127.0.0.1
SMTP_PORT=2525
SMTP_DOMAIN=example.invalid
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=plain
MAILER_SENDER_EMAIL=soporte@example.invalid
INITIAL_SETUP_COMPLETE=false
APP_URL=https://atencion.tu-dominio.cl
APP_HOST=atencion.tu-dominio.cl
